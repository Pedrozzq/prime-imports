# Copie este arquivo para ".env" (local) e preencha com suas credenciais reais.
# Em produção (Vercel), configure as mesmas variáveis em:
# Project Settings → Environment Variables
#
# NUNCA coloque o Access Token no front-end — ele só pode existir aqui e no
# ambiente do servidor. As funções api/create-preference.js e api/confirm-order.js
# leem via process.env.MP_ACCESS_TOKEN. O Checkout Pro roda na página do próprio
# Mercado Pago, então nem a Public Key precisa ficar no navegador.

# --- Mercado Pago ---
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx

# URL pública da loja, usada nas back_urls do Checkout Pro (para onde o Mercado
# Pago devolve o cliente após o pagamento). Se ficar vazio, o servidor usa o
# host da requisição — o que já funciona na Vercel. Preencha só se precisar
# fixar um domínio de retorno. Ex.: https://primeimportsbr.com.br
# PUBLIC_BASE_URL=

# --- E-mail dos pedidos (Resend — https://resend.com) ---
# Crie a conta do Resend com o próprio lojaprimeimportsbr@gmail.com e gere a
# API key em https://resend.com/api-keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Para onde os pedidos são enviados. Aceita vários e-mails separados por vírgula.
ORDER_EMAIL_TO=lojaprimeimportsbr@gmail.com

# Para onde vai o aviso de "cliente chegou ao checkout" (api/notify-checkout.js).
# Se ficar vazio, usa o mesmo destino do ORDER_EMAIL_TO. Aceita vários e-mails
# separados por vírgula.
CHECKOUT_EMAIL_TO=lojaprimeimportsbr@gmail.com

# Coloque "1" para desligar só o aviso de checkout, mantendo o e-mail do pedido.
# CHECKOUT_EMAIL_OFF=1

# Remetente. Enquanto não houver domínio verificado no Resend, mantenha
# onboarding@resend.dev — ele só entrega para o e-mail dono da conta Resend.
# Com domínio verificado, troque por algo como: Prime Imports BR <pedidos@seudominio.com.br>
ORDER_EMAIL_FROM=Prime Imports BR <onboarding@resend.dev>
